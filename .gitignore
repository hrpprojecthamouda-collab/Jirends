# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment / secrets — never commit Supabase keys
.env
.env.*
!.env.example
# Real env config (anon key + project URL). Template is env.example.dart.
lib/core/env/env.dart
# Real dev-account credentials (debug-only test logins). Template is
# dev_accounts.example.dart.
lib/core/env/dev_accounts.dart

# Generated code (freezed / json_serializable) — regenerated via build_runner
*.g.dart
*.freezed.dart

# Generated localizations (flutter gen-l10n from lib/l10n/*.arb). The ARB files
# are the source of truth and ARE tracked; the generated Dart is not.
lib/l10n/app_localizations*.dart
